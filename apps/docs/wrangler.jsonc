{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "langnostic",
  "account_id": "c9d3d3304c5e8ffd1c928e6b53249a2a",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "langnostic.com", "custom_domain": true },
    { "pattern": "www.langnostic.com", "custom_domain": true },
  ],
}

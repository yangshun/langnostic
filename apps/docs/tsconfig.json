{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    ".blume/.astro/types.d.ts",
    ".blume-verify/.astro/types.d.ts",
    "*.ts",
    "components/**/*.astro",
    "pages/**/*.astro"
  ],
  "exclude": ["node_modules", "dist"]
}

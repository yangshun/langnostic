{
  "name": "@langnostic/plugin-mdx",
  "version": "0.0.9",
  "description": "MDX plugin for Langnostic",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "check": "pnpm run tc && pnpm run lint",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check --write --unsafe",
    "format": "biome format --write",
    "tc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run tc && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lodash-es": "catalog:",
    "murmurhash": "^2.0.1",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "langnostic": "workspace:*"
  },
  "devDependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "langnostic": "workspace:*",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

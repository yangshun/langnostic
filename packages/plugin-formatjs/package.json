{
  "name": "@langnostic/plugin-formatjs",
  "version": "0.0.10",
  "description": "FormatJS message catalog plugin for Langnostic",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "check": "pnpm run tc && pnpm run lint",
    "dev": "vp pack --watch --no-minify",
    "build": "vp run build:package",
    "lint": "vp lint --fix",
    "format": "vp fmt --write",
    "tc": "vp run typecheck",
    "test": "vp run test:unit",
    "test:watch": "vp test watch",
    "verify": "npm run tc && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "fs-extra": "catalog:"
  },
  "devDependencies": {
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "langnostic": "workspace:*",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "langnostic": "workspace:*"
  }
}

{
  "name": "langnostic",
  "version": "0.0.9",
  "description": "Modern translation toolchain using AI",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "check": "pnpm run tc && pnpm run lint",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "biome check --write --unsafe",
    "format": "biome format --write",
    "tc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run tc && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ai": "^5.0.56",
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "dotenv": "^17.2.2",
    "fs-extra": "catalog:",
    "globby": "^14.1.0",
    "json5": "^2.2.3",
    "lodash-es": "catalog:",
    "log-update": "^7.0.1",
    "yargs": "^18.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/fs-extra": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "^17.0.33",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@langnostic/monorepo",
  "private": true,
  "scripts": {
    "build": "vp run -r build:package",
    "clean": "vp run -r clean",
    "dev": "vp run -r --parallel --no-cache dev",
    "format": "vp fmt --write",
    "lint": "vp run -r --cache lint",
    "tc": "vp run -r typecheck",
    "test": "vp run -r test:unit",
    "test:coverage": "vp test run --coverage",
    "publish-all": "pnpm -r publish --access public",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
